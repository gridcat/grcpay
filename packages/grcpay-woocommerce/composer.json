{
    "name": "gridcat/grcpay-woocommerce",
    "description": "WooCommerce payment gateway plugin for Gridcoin (GRC), powered by grcpay.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "CryptAPI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "test:coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
