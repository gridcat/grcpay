# Mainnet production build values. Loaded automatically by Next.js
# during `next build` (NODE_ENV=production), overriding the localhost
# defaults in .env. Every NEXT_PUBLIC_* below ends up baked into the
# client bundle — runtime env can't change them after the build.
#
# The testnet image overlays .env.testnet on top of this via
# .env.production.local (see Dockerfile).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL_SERVER=https://grcpay.gridcoin.club/api
NEXT_PUBLIC_SITE_URL=https://grcpay.gridcoin.club
NEXT_PUBLIC_TRACK=true
NEXT_PUBLIC_EXPLORER_URL=https://gridcoinstats.eu
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_SISTER_URL=https://testnet-grcpay.gridcoin.club
NEXT_TELEMETRY_DISABLED=1
