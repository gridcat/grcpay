# Build stage
FROM node:22.16.0 AS builder

WORKDIR /usr/src/app

# Install dependencies with clean install
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the application (compiles src/migrations/*.ts to dist/ as well,
# so the runtime migrator can pick them up via the FileMigrationProvider).
RUN npm run build

# Production stage
FROM node:22.16.0

LABEL maintainer="GrcPay Project"
LABEL description="Production environment for grcpay backend service"

WORKDIR /usr/src/app

# Copy only production dependencies and built assets
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/config.json ./config.json

# Run as the official node:* image's built-in `node` user (uid 1000,
# gid 1000) so a bind-mounted SQLite data dir from a typical host
# (host user is usually uid 1000 too) is writable without an extra
# host-side chown. If you run the container with a different host uid,
# `chown -R 1000:1000 <host-data-dir>` on the host once is enough.
RUN mkdir -p /usr/src/app/data && chown -R node:node /usr/src/app
USER node

# Expose default port
EXPOSE 7001

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:7001/status || exit 1

# Set production environment
ENV NODE_ENV=production

# Migrations are applied on boot by src/index.ts before the listener
# opens, so the SQLite volume can be empty on first run with no
# separate migration step.
CMD ["npm", "start"]
