# Build stage
FROM node:22.16.0 AS builder

WORKDIR /usr/src/app

# Install dependencies with clean install
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

RUN npm run prisma

# Build the application
RUN npm run build

# Production stage
FROM node:22.16.0

LABEL maintainer="Gridcoin Pay Project"
LABEL description="Production environment for grcpay backend service"

WORKDIR /usr/src/app

# Copy only production dependencies and built assets
COPY package*.json ./
RUN npm ci --only=production
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/prisma ./prisma
COPY --from=builder /usr/src/app/config.json ./config.json
RUN npm run prisma

# Create non-root user and ensure the SQLite data directory is writable
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser && \
    mkdir -p /usr/src/app/data && \
    chown -R appuser:appgroup /usr/src/app
USER appuser

# Expose default port
EXPOSE 7001

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:7001/status || exit 1

# Set production environment
ENV NODE_ENV=production

# Apply pending Prisma migrations on boot, then start the server.
# The SQLite file lives in a mounted volume, so it may be empty on first run.
CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
